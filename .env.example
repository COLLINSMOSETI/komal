# Supabase project URL and server-side service_role key. Never put this key in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail SMTP alerts. Use a Google App Password, not your Gmail account password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
LOGIN_NOTIFY_EMAIL=moseticollins20@gmail.com
