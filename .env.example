# Supabase project URL and server-side service_role key. Never put this key in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend email alerts. Verify the sender domain with Resend before using it.
RESEND_API_KEY=re_your_api_key
LOGIN_NOTIFY_EMAIL=you@example.com
LOGIN_NOTIFY_FROM="Komal Login Alerts <alerts@your-verified-domain.com>"
